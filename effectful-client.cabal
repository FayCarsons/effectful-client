cabal-version:      3.0
name:               effectful-client
version:            0.1.0.0
synopsis:           An HTTP client as a dynamic effect, with retries and middleware
description:
  An @http-client@ wrapper exposing a single dynamic effect operation, so that
  retries, authentication, base URLs and observation are ordinary
  @Eff es a -> Eff es a@ functions built on @interpose@ rather than fields on
  an interpreter.
  .
  Transport failures are values rather than exceptions, and non-2xx responses
  are not failures at all, so a retry policy is a pattern match instead of a
  tower of @catch@. Requests are built variadically:
  .
  > get (https "api.example.com" /: "v1" /: "users")
  >   (header "Accept" "application/json")
  >   (param "page" "2")
  >   :: Eff es (Outcome [User])
  .
  See "Effectful.Http" to get started, "Effectful.Http.Retry" for the retry
  algebra, and "Effectful.Http.Middleware" for request shaping.

license:            BSD-3-Clause
license-file:       LICENSE
copyright:          (c) 2026 Fay Carsons
author:             Fay Carsons
maintainer:         faycarsons23@gmail.com
homepage:           https://github.com/faycarsons/effectful-client
bug-reports:        https://github.com/faycarsons/effectful-client/issues
category:           Network
build-type:         Simple
tested-with:        GHC ==9.12.3
extra-doc-files:    CHANGELOG.md

source-repository head
  type:     git
  location: https://github.com/faycarsons/effectful-client

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Wmissing-deriving-strategies
    -Wpartial-fields
    -Wredundant-constraints
    -Wunused-packages
    -Wno-name-shadowing
    -Wno-orphans

common extensions
  default-language:   GHC2024
  default-extensions:
    ConstraintKinds
    DataKinds
    DeriveAnyClass
    DeriveFunctor
    DeriveGeneric
    DerivingStrategies
    DuplicateRecordFields
    EmptyDataDecls
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    ImportQualifiedPost
    KindSignatures
    LambdaCase
    MultiParamTypeClasses
    NamedFieldPuns
    NoFieldSelectors
    NumericUnderscores
    OverloadedLists
    OverloadedRecordDot
    OverloadedStrings
    PatternGuards
    QuasiQuotes
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    Strict
    StrictData
    TemplateHaskell
    TypeApplications
    TypeFamilies
    TypeOperators
    UndecidableInstances
    ViewPatterns

flag tls
  description:
    Expose "Effectful.Http.TLS", which builds TLS-capable connection managers.
    Turning this off drops the http-client-tls dependency, and with it the tls
    and crypton stack; supply runHttp a Manager of your own instead.
  default:     True
  manual:      True

library
  import:
    , warnings
    , extensions
  hs-source-dirs:   src
  exposed-modules:
      Effectful.Http
    , Effectful.Http.Duration
    , Effectful.Http.Middleware
    , Effectful.Http.Retry
  build-depends:
      base                >=4.21   && <5
    , aeson               >=2.3.1  && <2.4
    , base64-bytestring   >=1.2.1  && <1.3
    , bytestring          >=0.12.2 && <0.13
    , effectful           >=2.6.1  && <2.7
    , effectful-core      >=2.6.1  && <2.7
    , http-client         >=0.7.19 && <0.8
    , http-types          >=0.12.5 && <0.13
    , random              >=1.3.1  && <1.4
    , text                >=2.1.3  && <2.2
    , time                >=1.14   && <1.17

  if flag(tls)
    exposed-modules: Effectful.Http.TLS
    build-depends:   http-client-tls >=0.4 && <0.5

test-suite effectful-client-test
  import:
    , warnings
    , extensions
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
      ClientSpec
    , RetrySpec
    , Scripted
  build-depends:
      base
    , bytestring
    , effectful
    , effectful-client
    , effectful-core
    , hedgehog            >=1.7     && <1.8
    , hspec               >=2.11.17 && <2.12
    , hspec-hedgehog      >=0.3     && <0.4
    , http-client
    , http-types
    , text
